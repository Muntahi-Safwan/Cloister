{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for Cloister's own UI webview only. Service pages never receive these; see src/runtime/capabilities.rs.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-background-color",
    "opener:allow-open-url",
    "allow-get-snapshot",
    "allow-list-catalog",
    "allow-add-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-activate-service",
    "allow-reload-service",
    "allow-set-service-icon",
    "allow-rename-service",
    "allow-mute-service",
    "allow-sleep-service",
    "allow-zoom-service",
    "allow-open-service-externally",
    "allow-set-content-bounds",
    "allow-set-overlay-open",
    "allow-set-veil",
    "allow-start-focus",
    "allow-end-focus",
    "allow-update-settings",
    "allow-send-test-notification",
    "allow-lock-now",
    "allow-unlock",
    "allow-get-history",
    "allow-clear-history",
    "allow-service-memory",
    "allow-erase-service-data",
    "allow-erase-all-data"
  ]
}
