{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "$lib/*": ["./src/lib/*"]
    },
    "baseUrl": ".",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "svelte.config.js",
    "eslint.config.js",
    "src/**/*.test.ts",
    "src-tauri/scripts/**/*.test.ts"
  ]
}
